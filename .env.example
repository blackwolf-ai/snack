# Copy to .env and fill in. Do not commit .env.
# snack reads these from the environment; they override snack.yaml.

# Token from @BotFather. Treat it like a password.
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram chat IDs allowed to operate this agent.
# Group IDs are negative. Example: 123456789,-1001234567890
SNACK_ALLOWED_CHAT_IDS=

# Optional path to the YAML config. Defaults to ./snack.yaml.
SNACK_CONFIG=snack.yaml
